# Supabase project credentials (Supabase dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only key, used by the swelist import route. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Password gate for the whole app (pick any strong passphrase).
# Required before deploying anywhere public; also add it to Vercel env vars.
APP_PASSWORD=pick-a-strong-passphrase

# --- Optional: automation ---
# Shared secret for scheduled jobs. Vercel Cron automatically sends it as
# "Authorization: Bearer <CRON_SECRET>" when this env var is set.
CRON_SECRET=generate-a-long-random-string

# Email deadline digests via Resend (https://resend.com). Leave unset to skip.
RESEND_API_KEY=
REMINDER_TO=you@example.com
# REMINDER_FROM="Internship Dashboard <onboarding@resend.dev>"

# Resume tailoring via the Claude API (https://platform.claude.com).
# Leave unset to hide the feature. Requires migration-003-resume.sql.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
